# ── FinanzasSaaS — variables de entorno ────────────────────────────
# Copia este archivo a .env y rellena los valores reales.
# NUNCA comitees el archivo .env (está en .gitignore).

# Backend
PORT=3999
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
NODE_ENV=development
LOG_LEVEL=info

# Base de datos Turso (https://turso.tech)
TURSO_DATABASE_URL=libsql://TU-DATABASE.turso.io
TURSO_AUTH_TOKEN=tu-token-de-autenticacion

# Frontend (Vite)
VITE_API_URL=http://localhost:3999

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_cambia-esta-key
FROM_EMAIL=FinanzasSaaS <no-reply@tudominio.com>
APP_URL=http://localhost:5173

# CORS (opcional; por defecto localhost:5173 + vercel.app)
# ALLOWED_ORIGINS=https://tu-dominio.com,https://otro-dominio.com
